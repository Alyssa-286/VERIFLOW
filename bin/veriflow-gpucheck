#!/bin/bash
# veriflow-gpucheck — run only inside a GPU allocation (srun/sbatch or an
# interactive shell on the GPU node). On the cluster: sbatch slurm/gpucheck.sbatch
set -euo pipefail
cd "$(dirname "$0")/.."
if [ -d .venv ]; then source .venv/bin/activate; fi
exec python -m scripts.gpucheck "--models" "$@"
